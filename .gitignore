scripts/tutoring/students
.env
.config/nvim/todo.txt
personal-secrets/

# ~/.claude is a symlink to this repo's .claude/, so all Claude Code runtime
# state (daemon locks+keys, caches, logs, session/team dirs, a 260MB venv)
# lands in the worktree. Deny by default; re-include only what's versioned.
.claude/*
!.claude/hooks/
!.claude/scripts-misc/
!.claude/settings.json
!.claude/statusline-command.sh
!.claude/plugins/
.claude/plugins/*
!.claude/plugins/blocklist.json
!.claude/plugins/config.json
